{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/python3:*)",
      "Bash(python -m py_compile:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Bash(scripts/colab_run.py:*)",
      "Bash(python scripts/colab_run.py:*)",
      "Bash(python3 scripts/colab_run.py:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pycompile_check.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "eli5@claude-community": true
  }
}
